layout {
  tab name="just-pick" {
    pane size=80% borderless=true floating=true {
      command "bash"
      args "-c", "recipe=$(just --list | fzf --height=40% --border --prompt='Recipe: '); [[ -n \"$recipe\" ]] && just \"$recipe\"; read -n1 -rsp 'Press any key to close...'; zellij action close-pane"
    }
  }
}