{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "basedpyright": {
      "command": [
        "basedpyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ],
      "env": {},
      "initialization": {
        "check": true
      }
    },
    "eslint": {
      "disabled": true
    },
    "biome": {
      "disabled": true
    }
  },
  "mcp": {
    "browsermcp": {
      "type": "local",
      "command": [
        "bunx",
        "@browsermcp/mcp@latest"
      ]
    },
    "playwright": {
      "type": "local",
      "command": [
        "bunx",
        "@playwright/mcp@latest"
      ]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-ec6f502a-a000-4b1f-9857-989c1619b4fg"
      },
    },
    "lucide-icon": {
      "type": "local",
      "command": [
        "bunx",
        "lucide-icons-mcp",
        "--stdio"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "shadcn": {
      "type": "local",
      "command": [
        "bunx",
        "shadcn@latest",
        "mcp"
      ]
    },
    "cloudflare-observability": {
      "type": "local",
      "enabled": false,
      "command": [
        "bunx",
        "mcp-remote",
        "https://observability.mcp.cloudflare.com/mcp"
      ]
    },
    "cloudflare-docs": {
      "type": "local",
      "enabled": false,
      "command": [
        "bunx",
        "mcp-remote",
        "https://docs.mcp.cloudflare.com/mcp"
      ]
    }
  }
}
