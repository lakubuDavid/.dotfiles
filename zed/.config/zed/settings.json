  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": true,
    },
    "blame": {
      "show_avatar": true,
    },
  },
  "edit_predictions": {
    "provider": "zed",
    "codestral": {
      "api_url": "https://codestral.mistral.ai",
    },
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
      "enterprise_uri": null,
    },
    "enabled_in_text_threads": false,
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": false,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": false,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "toggle_on_modifiers_press": null,
  },
  "icon_theme": "Warm Charmed Icons",
  "agent": {
    "default_profile": "write",
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "create_directory": {
          "default": "allow",
        },
        "mcp:software-planning-tool:update_todo_status": {
          "default": "allow",
        },
        "mcp:software-planning-tool:save_plan": {
          "default": "allow",
        },
        "mcp:software-planning-tool:add_todo": {
          "default": "allow",
        },
        "mcp:mcp-server-context7:query-docs": {
          "default": "allow",
        },
        "fetch": {
          "default": "allow",
        },
        "terminal": {
          "default": "allow",
        },
        "mcp:bun-docs-mcp:SearchBun": {
          "default": "allow",
        },
      },
    },
    "default_model": {
      "enable_thinking": false,
      "provider": "opencode",
      "model": "minimax-m2.5-free",
    },
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "gemini-3-flash-preview",
      },
      {
        "provider": "copilot_chat",
        "model": "claude-opus-4.6",
      },
      {
        "provider": "copilot_chat",
        "model": "claude-opus-4.5",
      },
      {
        "provider": "copilot_chat",
        "model": "gemini-2.5-pro",
      },
      {
        "provider": "copilot_chat",
        "model": "claude-haiku-4.5",
      },
    ],
    "model_parameters": [],
    "commit_message_model": {
      "provider": "copilot_chat",
      "model": "claude-haiku-4.5",
    },
  },
  "double_click_in_multibuffer": "open",
  "auto_update": true,
  "ensure_final_newline_on_save": true,

  // "chat_panel": {
  //   "dock": "left"
  // },
  "collaboration_panel": {
    "dock": "left",
  },
  "vim_mode": false,
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "left",
  },
  "base_keymap": "VSCode",
  "theme": "Catppuccin Frappé",
  "ui_font_size": 13,
  "use_system_window_tabs": true,
  "buffer_font_size": 13,
  "buffer_font_weight": 500,
  "buffer_font_family": "VictorMono Nerd Font",
  "ui_font_family": "Zed Plex Mono",
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "confirm_quit": true,
  "tabs": {
    "file_icons": true,
  },
  "status_bar": {
    "active_language_button": true,
  },
  "auto_indent_on_paste": true,
  "lsp_document_colors": "inlay",
  "tab_size": 2,
  "ssh_connections": [
    {
      "host": "debian.local",
      "username": "davidlakubu",
      "port": 22,
      "args": ["-i", "~/.ssh/home-debian"],
      "projects": [
        {
          "paths": ["~/server"],
        },
      ],
    },
    {
      "host": "100.119.67.117",
      "username": "gaming3",
      "args": [],
      "projects": [
        {
          "paths": ["/home/gaming3/eclosia"],
        },
      ],
    },
  ],
  "code_actions_on_format": {
    "source.fixAll.biome": true,
  },
  "languages": {
    "Python": {
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
      // "language_servers": ["ruff"]
      // Or, if there are other language servers you want to use with Python
      "language_servers": [
        // "pyright",
        "ruff",
        "basedpyright",
        // disable the other python language servers
        "!pyright",
        "!pylsp",
      ],
    },
    // "TypeScript": {
    //   "formatter": "language_server",
    //   "language_servers": [""]
    // },
    "TypeScript": {
      "prettier": {
        "allowed": false,
      },

      "colorize_brackets": true,
      "soft_wrap": "editor_width",
      "language_servers": [
        "!tsgo",
        "typescript-language-server",
        "!vtsls",
        "oxlint",
        // "...",
      ],
    },
    "TSX": {
      "prettier": {
        "allowed": false,
      },

      "colorize_brackets": true,
      "soft_wrap": "editor_width",
      "language_servers": [
        "!tsgo",
        "typescript-language-server",
        "!vtsls",
        "oxlint",
        // "...",
      ],
      // "language_servers": ["typescript-language-server", "!vtsls"],
    },
    "JavaScript": {
      "language_servers": ["typescript-language-server", "!vtsls"],
    },
    "Teal": {
      "language_servers": ["teal-lsp"],
    },
    "HTML": {
      "language_servers": ["!superhtml"],
    },
    "GDScript": {
      "formatter": {
        "external": {
          "command": "gdscript-formatter",
          "arguments": ["--use-spaces", "--indent-size", "2", "--safe"],
        },
      },
      "format_on_save": "on",
    },
  },
  "lsp": {
    "teal-lsp": {
      "binary": {
        "path": "teal-language-server",
      },
    },
    "pyright": {
      "settings": {
        "python": {
          "pythonPath": ".venv/bin/python",
        },
      },
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          // Ruff server settings goes here
          "lineLength": 80,
          "lint": {
            "extendSelect": ["I"],
          },
        },
      },
    },
  },
}
